OPSPILOT_ENVIRONMENT=development
OPSPILOT_DEMO_DATA_ENABLED=false
OPSPILOT_LOG_LEVEL=INFO
OPSPILOT_DOCS_ENABLED=true
OPSPILOT_REQUIRE_HTTPS=false
OPSPILOT_TRUST_FORWARDED_PROTO=false
OPSPILOT_DATABASE_URL=postgresql+asyncpg://opspilot:opspilot@localhost:5432/opspilot
# OPSPILOT_DATABASE_PASSWORD_FILE=/run/secrets/postgres_password
OPSPILOT_DATABASE_READINESS_ENABLED=true
OPSPILOT_STARTUP_RECOVERY_ENABLED=true
OPSPILOT_STARTUP_RECOVERY_RETRY_SECONDS=30
OPSPILOT_CORS_ORIGINS=["http://localhost:5173"]
OPSPILOT_OUTBOX_PUBLISHER_MODE=log
OPSPILOT_OUTBOX_PUBLISHER_INTERVAL_SECONDS=1
OPSPILOT_OUTBOX_PUBLISHER_BATCH_SIZE=100
OPSPILOT_OUTBOX_MAX_PUBLISH_ATTEMPTS=10
OPSPILOT_OUTBOX_RETRY_BASE_SECONDS=2
OPSPILOT_OUTBOX_RETRY_MAX_SECONDS=300
OPSPILOT_OUTBOX_RETENTION_DAYS=7
OPSPILOT_AUDIT_RETENTION_DAYS=365
OPSPILOT_AUDIT_ARCHIVE_BATCH_SIZE=10000
# OPSPILOT_OUTBOX_WEBHOOK_URL=https://events.example.com/opspilot
# OPSPILOT_OUTBOX_WEBHOOK_TOKEN_FILE=/run/secrets/outbox_webhook_token
OPSPILOT_OUTBOX_WEBHOOK_TIMEOUT_SECONDS=10
OPSPILOT_ALERT_CORRELATION_WINDOW_SECONDS=900
OPSPILOT_ALERTMANAGER_WEBHOOK_TOKEN=
# OPSPILOT_ALERTMANAGER_WEBHOOK_TOKEN_FILE=/run/secrets/alertmanager_webhook_token
OPSPILOT_RUNNER_BOOTSTRAP_TOKEN=
# OPSPILOT_RUNNER_BOOTSTRAP_TOKEN_FILE=/run/secrets/runner_bootstrap_token
OPSPILOT_CONTROL_PLANE_AUTH_ENABLED=true
OPSPILOT_CONTROL_PLANE_BOOTSTRAP_TOKEN=
# OPSPILOT_CONTROL_PLANE_BOOTSTRAP_TOKEN_FILE=/run/secrets/control_plane_bootstrap_token
OPSPILOT_PRINCIPAL_TOKEN_TTL_SECONDS=2592000
OPSPILOT_BROWSER_SESSION_TTL_SECONDS=28800
OPSPILOT_BROWSER_SESSION_ABSOLUTE_TTL_SECONDS=604800
# Production defaults true; local development may keep false.
OPSPILOT_BROWSER_COOKIE_SECURE=false
OPSPILOT_RUNNER_LEASE_SECONDS=60
OPSPILOT_RUNNER_TASK_LEASE_SECONDS=120
OPSPILOT_RUNNER_TASK_MAX_OUTPUT_BYTES=65536
OPSPILOT_RUNNER_TOKEN_ROTATION_SECONDS=86400
OPSPILOT_RUNNER_TOKEN_TTL_SECONDS=604800
OPSPILOT_RUNNER_TOKEN_GRACE_SECONDS=600
OPSPILOT_OBSERVABILITY_MONITOR_INTERVAL_SECONDS=15
OPSPILOT_WORKER_HEALTH_STALE_MULTIPLIER=3
OPSPILOT_WORKER_HEALTH_ERROR_THRESHOLD=3
OPSPILOT_AGENT_RUNTIME_ENABLED=false
OPSPILOT_AGENT_RUNTIME_POLL_INTERVAL_SECONDS=2
OPSPILOT_AGENT_RUNTIME_LEASE_SECONDS=60
OPSPILOT_AGENT_RUNTIME_NO_PROGRESS_LIMIT=3
OPSPILOT_AGENT_MODEL_NAME=
OPSPILOT_AGENT_MODEL_API_KEY=
OPSPILOT_AGENT_MODEL_BASE_URL=
OPSPILOT_AGENT_MODEL_REQUEST_LIMIT=2
OPSPILOT_AGENT_MODEL_INPUT_TOKENS_LIMIT=16000
OPSPILOT_AGENT_MODEL_OUTPUT_TOKENS_LIMIT=4000
