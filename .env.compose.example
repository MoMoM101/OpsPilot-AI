# Copy this file to .env, replace every secret, then run
# .\scripts\prepare-compose-secrets.ps1 before starting Compose.
OPSPILOT_POSTGRES_PASSWORD=replace-with-a-random-database-password
OPSPILOT_ALERTMANAGER_WEBHOOK_TOKEN=replace-with-a-random-webhook-token
OPSPILOT_RUNNER_BOOTSTRAP_TOKEN=replace-with-a-random-runner-bootstrap-token
OPSPILOT_CONTROL_PLANE_BOOTSTRAP_TOKEN=replace-with-a-random-control-plane-token

OPSPILOT_POSTGRES_PORT=5432
OPSPILOT_BACKEND_PORT=8000
# Keep the console private by default. For public access, use a TLS reverse proxy.
OPSPILOT_FRONTEND_BIND_ADDRESS=127.0.0.1
OPSPILOT_FRONTEND_PORT=8080

# Optional local-only fault lab. Never reuse this development token elsewhere.
OPSPILOT_LAB_TOKEN=replace-with-a-local-fault-lab-token
OPSPILOT_LAB_RAG_PORT=18000
# Access token of a dedicated unrestricted Admin principal used only by Lab E2E.
OPSPILOT_LAB_E2E_ACCESS_TOKEN=

# Optional Runner profile settings. Create an Environment first, then set its UUID.
OPSPILOT_RUNNER_NAME=docker-runner
OPSPILOT_RUNNER_ENVIRONMENT_ID=
OPSPILOT_RUNNER_HEARTBEAT_SECONDS=20
OPSPILOT_RUNNER_TASK_RENEW_SECONDS=30
OPSPILOT_RUNNER_CONNECTOR_CIRCUIT_FAILURE_THRESHOLD=5
OPSPILOT_RUNNER_CONNECTOR_CIRCUIT_RECOVERY_SECONDS=30
OPSPILOT_RUNNER_CONNECTOR_RETRY_MAX_ATTEMPTS=2
OPSPILOT_RUNNER_CONNECTOR_RETRY_BASE_SECONDS=0.2
OPSPILOT_RUNNER_CONNECTOR_RETRY_MAX_SECONDS=2
OPSPILOT_RUNNER_CONNECTOR_RETRY_JITTER_RATIO=0.2
# JSON arrays. Keep empty until the Phase 5 lab services/volumes are enabled.
OPSPILOT_RUNNER_PROBE_ALLOWED_HOSTS=[]
OPSPILOT_RUNNER_PROBE_ALLOWED_PORTS=[]
OPSPILOT_RUNNER_SQLITE_ALLOWED_ROOTS=[]
# Linux: stat -c '%g' /var/run/docker.sock
OPSPILOT_DOCKER_GID=0
